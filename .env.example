# Ask My Body — 公开版本的环境变量模板（入 git）
# 真实值在 .env.local（不入 git）

# LLM API — 支持 Anthropic 原生 / 302.ai 中转
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.302.ai

# Vercel KV
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# 鉴权 secrets
CRON_SECRET=
SHORTCUT_SECRET=

# 单用户配置
OWNER_USER_ID=
